{
  "expo": {
    "name": "Agria",
    "slug": "agria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agria",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FDF8EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.agria.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Agria utilise votre position pour vous localiser sur la carte de vos parcelles."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF8EE"
      },
      "package": "fr.agria.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Agria a besoin d'acces a vos photos pour personnaliser votre profil.",
          "cameraPermission": "Agria a besoin d'acces a l'appareil photo pour votre avatar."
        }
      ]
    ]
  }
}
