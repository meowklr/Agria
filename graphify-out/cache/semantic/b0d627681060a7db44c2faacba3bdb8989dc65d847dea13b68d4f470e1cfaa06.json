{"nodes": [{"id": "golden_hour_design_system", "label": "Golden Hour Design System", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-20-agria-golden-hour-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm wheat-field aesthetic, cinematic yet clean. Direction: Golden Hour / Champs de bl\u00c3\u00a9 \u00e2\u20ac\u201d chaleureux, cin\u00c3\u00a9matique, \u00c3\u00a9pur\u00c3\u00a9."}, {"id": "golden_hour_palette", "label": "Golden Hour Color Palette", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-20-agria-golden-hour-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm cream bg #FDF8EE, gold primary #E8B84B, earthy text #3D2E1F. Single light theme, no dark mode."}, {"id": "golden_hour_typography", "label": "Fraunces + Outfit Typography", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-20-agria-golden-hour-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fraunces (serif warm) for titles, Outfit (geometric warm) for body/UI. Mobile-first 16px base."}, {"id": "golden_hour_mobile_first", "label": "Mobile-First Single-Column Layout", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-20-agria-golden-hour-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "max-width: 420px centered on desktop, no grids, no sidebars. Single vertical view simplifies development and ensures mobile parity."}, {"id": "golden_hour_components", "label": "Golden Hour UI Components", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-20-agria-golden-hour-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contribu